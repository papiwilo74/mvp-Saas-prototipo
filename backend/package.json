{
  "name": "fastfood-saas-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "bootstrap": "node scripts/bootstrap.js",
    "db:setup": "npx prisma migrate dev && npx prisma db seed",
    "db:reset": "npx prisma migrate reset --force",
    "env:validate": "node ./src/config/env.js",
    "verify:deploy": "node scripts/deploy-verify.js",
    "verify:local": "node scripts/deploy-verify.js --url=http://localhost:4000/api",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\""
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@sentry/node": "^10.68.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.41.6",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "resend": "^4.0.1",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.9.6",
    "prisma": "^6.9.0",
    "supertest": "^7.2.2",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
