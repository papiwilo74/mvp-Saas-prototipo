# ============================================================
# PRODUCTION Environment Template - OrderFlow SaaS
# Use this as a reference for your Render.com Environment settings
# ============================================================

# --- App ---
NODE_ENV=production
PORT=4000

# --- Database (Neon / PostgreSQL) ---
# DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# --- Auth (JWT Criptográficamente Seguros) ---
JWT_SECRET="GENERATE_STRONG_RANDOM_64_BYTE_HEX_STRING"
JWT_REFRESH_SECRET="GENERATE_STRONG_RANDOM_64_BYTE_HEX_STRING"
JWT_RESET_SECRET="GENERATE_STRONG_RANDOM_64_BYTE_HEX_STRING"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Frontend & CORS ---
FRONTEND_URL="https://www.orderflowapp.online"
ALLOWED_ORIGINS="https://orderflowapp.online,https://www.orderflowapp.online"

# --- Rate Limiting (Producción) ---
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=100

# --- Email (Resend) ---
RESEND_API_KEY="re_tu_api_key"
EMAIL_FROM="OrderFlow <soporte@orderflowapp.online>"
RESEND_FROM="soporte@orderflowapp.online"

# --- Cloudinary (Almacenamiento de Fotos de Menús/Productos) ---
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# --- Pasarela de Pagos (Wompi) ---
WOMPI_ENV="sandbox"
# WOMPI_PUBLIC_KEY="pub_test_..."
# WOMPI_PRIVATE_KEY="prv_test_..."
# WOMPI_EVENTS_SECRET=""

# --- Mapas & Domicilios (Mapbox) ---
MAPBOX_ACCESS_TOKEN="pk.tu_token"
