# ============================================================
# Backend Environment Variables
#
# SETUP:
#   1. Copy this file to .env:
#        cp .env.example .env
#   2. Fill in real values for your environment.
#   3. Run "npm run env:validate" to check your config.
#   4. Run "npm run bootstrap" to install deps and init the DB.
#
# For development, see: .env.development
# For production, see:  .env.production.example
# ============================================================

# ============================
# App
# ============================
NODE_ENV=development
PORT=4000

# ============================
# Database (PostgreSQL / Neon)
# ============================
# Connection string for Prisma
DATABASE_URL="postgresql://neondb_owner:npg_H7UxiEvzG1hc@ep-frosty-union-axbjkk60.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection for migrations
DIRECT_URL="postgresql://neondb_owner:npg_H7UxiEvzG1hc@ep-frosty-union-axbjkk60.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ============================
# Auth (JWT)
# ============================
# Generate strong secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-me-with-a-long-secret-at-least-24-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-me-with-another-long-secret"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_RESET_SECRET="change-me-with-reset-password-secret"

# ============================
# Frontend (CORS)
# ============================
# URL of the frontend app. Used for CORS and redirects.
FRONTEND_URL="http://localhost:5173"
# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS="http://localhost:5173"

# ============================
# Error Monitoring (Sentry — optional)
# ============================
# Get your DSN at https://sentry.io
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# ============================
# Rate Limiting
# ============================
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=60
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=100
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=200

# ============================
# Email (Resend — optional)
# ============================
# Get your API key at https://resend.com
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="TuTienda SaaS <pedidos@tu-dominio.com>"

# ============================
# Cloudinary (image uploads — optional)
# ============================
# Get credentials at https://cloudinary.com
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="123456789"
CLOUDINARY_API_SECRET="abc123def456"

# ============================
# Wompi (opcional - aplazado)
# ============================
# WOMPI_ENV="sandbox"
# WOMPI_PUBLIC_KEY=""
# WOMPI_PRIVATE_KEY=""
# WOMPI_EVENTS_SECRET=""

# ============================
# Mapbox API (Geocodificacion y Calculo de Distancias)
# ============================
# Consigue tu Access Token en https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN="pk.eyJ1I..."

# ============================
# Push Notifications (Web Push / VAPID)
# ============================
# Generate VAPID keys:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
